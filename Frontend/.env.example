# Copy this file to .env.local for local development
# Set these as Environment Variables in your Vercel dashboard for production

# RECOMMENDED: leave VITE_API_URL UNSET on Vercel.
# Frontend/vercel.json proxies /api/v1 and /uploads to Render, so the browser
# only ever talks to your Vercel domain (first-party cookies, works in Safari,
# photos load). In development the Vite proxy does the same job.
#
# Only set this if you deliberately call Render directly (cross-site cookies,
# breaks in Safari/Brave, and /uploads photos will not load):
# VITE_API_URL=https://your-backend.onrender.com/api/v1
